{# Generated by sylius/starter-core: shop logo when a package contributes one, Sylius logo otherwise. #}
{% set brand = storefront_brand() %}
{% if brand.logo %}
    <img src="{{ brand.logo }}" alt="{{ brand.logoAlt ?? brand.name ?? '' }}" class="img-fluid d-block" style="max-height: 2.5rem;">
{% else %}
    {% include '@!SyliusShop/shared/logo.html.twig' %}
{% endif %}
